---
import BaseLayout from '../layouts/BaseLayout.astro';
import writingItems from '../content/writing.json';

const featuredItems = [...writingItems]
  .filter((item) => item.featured)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<BaseLayout
  title="Shivam Hegadi — Writing Portfolio"
  description="Professional writing portfolio featuring systems, engineering leadership, and technical strategy essays."
  pathname="/"
>
  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="#top">Shivam Hegadi</a>
      <nav aria-label="Main navigation">
        <ul class="nav-list">
          <li><a href="#work">Work</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
          <li><a href="/writing">Writing Index</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="hero container" aria-labelledby="hero-title">
      <p class="eyebrow">Writing Portfolio</p>
      <h1 id="hero-title">Systems thinking, written clearly.</h1>
      <p class="hero-copy">
        Placeholder positioning statement: I write about engineering systems, team execution,
        and practical technical leadership.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#work">View writing</a>
        <a class="btn btn-secondary" href="#contact">Contact</a>
      </div>
    </section>

    <section id="work" class="container section" aria-labelledby="featured-title">
      <div class="section-head">
        <h2 id="featured-title">Featured writing</h2>
        <a class="text-link" href="/writing">See all writing</a>
      </div>
      <div class="card-grid">
        {featuredItems.map((item) => (
          <article class="card">
            <p class="meta">{item.publication} · {new Date(item.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
            <h3><a href={item.url} target="_blank" rel="noreferrer">{item.title}</a></h3>
            <p>{item.summary}</p>
            <ul class="tags" aria-label="Tags">
              {item.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="about" class="container section" aria-labelledby="about-title">
      <h2 id="about-title">About</h2>
      <p>
        Placeholder bio: Shivam is an engineer and writer focused on reliable systems,
        pragmatic architecture, and high-performing teams. Replace this text with a short
        personal introduction and areas of expertise.
      </p>
    </section>

    <section id="contact" class="container section" aria-labelledby="contact-title">
      <h2 id="contact-title">Contact</h2>
      <p>
        Email: <a href="mailto:hello@shivamhegadi.systems">hello@shivamhegadi.systems</a>
      </p>
      <ul class="social-links">
        <li><a href="https://www.linkedin.com" target="_blank" rel="noreferrer">LinkedIn (placeholder)</a></li>
        <li><a href="https://x.com" target="_blank" rel="noreferrer">X / Twitter (placeholder)</a></li>
        <li><a href="https://github.com" target="_blank" rel="noreferrer">GitHub (placeholder)</a></li>
      </ul>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer-wrap">
      <p>© {new Date().getFullYear()} Shivam Hegadi</p>
      <ul>
        <li><a href="/writing">Writing</a></li>
        <li><a href="#about">About</a></li>
      </ul>
    </div>
  </footer>
</BaseLayout>
